# Copy this file to `.env.local` (dev) or set these on your host (Render, Vercel).
# Never commit real values — .gitignore keeps .env and .env.local out of git.

# ─── Gmail (Contact form) ─────────────────────────────────────
# GMAIL_USER          — the Gmail address that will *send* the message.
# GMAIL_APP_PASSWORD  — 16-character Google App Password (NOT your Gmail login).
#
# How to generate an App Password:
#   1. Sign in to https://myaccount.google.com/security
#   2. Turn on 2-Step Verification (required — App Passwords need 2FA).
#   3. Visit https://myaccount.google.com/apppasswords
#   4. App = "Mail", Device = "Other" → name it "vbphotographe.com"
#   5. Google shows a 16-char password like: abcd efgh ijkl mnop
#      Paste it below WITHOUT the spaces.
#
GMAIL_USER=vbphotograph2015@gmail.com
GMAIL_APP_PASSWORD=

# Optional — override the recipient (defaults to vbphotograph2015@gmail.com)
# CONTACT_TO=vbphotograph2015@gmail.com


# ─── Cloudflare R2 (image CDN — optional) ─────────────────────
# Full walkthrough: docs/CLOUDFLARE_SETUP.md
#
# Leave NEXT_PUBLIC_CDN_BASE_URL blank in dev to serve photos from
# the local public/assets folder.
NEXT_PUBLIC_CDN_BASE_URL=

# Only needed by `npm run upload` (photo sync script).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vb-photographe
