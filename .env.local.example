# Copy this file to `.env.local` for local development.
# In production (Render), set these in the dashboard → Environment tab.
# Real credentials must NEVER be committed — .gitignore ignores .env* files.

# ─── Gmail (Contact form) ─────────────────────────────────────
# Uses Nodemailer + Gmail SMTP (port 465, TLS).
#
# 1) Enable 2-Step Verification on the Gmail account:
#      https://myaccount.google.com/security
# 2) Generate an App Password:
#      https://myaccount.google.com/apppasswords
#      → App: "Mail"  Device: "Other" → name it "vbphotographe.com"
# 3) Google shows a 16-char password (e.g. "abcd efgh ijkl mnop").
#    Paste it below with NO spaces.
#
GMAIL_USER=vbphotograph2015@gmail.com
GMAIL_APP_PASSWORD=

# Optional — recipient (defaults to vbphotograph2015@gmail.com)
# CONTACT_TO=vbphotograph2015@gmail.com


# ─── Cloudflare R2 (image CDN — optional) ─────────────────────
# Full setup walkthrough: docs/CLOUDFLARE_SETUP.md
#
# In dev, leave blank to serve photos from local public/assets/.
# In production, set to your R2 public URL or custom Cloudflare domain.
NEXT_PUBLIC_CDN_BASE_URL=

# Only needed by `npm run upload`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vb-photographe
