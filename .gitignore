# deps
node_modules
.pnp
.pnp.*
.yarn/*

# next
.next
out
build

# env — never commit real credentials. Only .env.example / .env.local.example
# (placeholder files) may be committed.
.env
.env.*
!.env.example
!.env.*.example

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel
next-env.d.ts.bak

# ts
*.tsbuildinfo

# Photography assets — 2.85 GB of hi-res JPGs live in public/assets/.
# GitHub caps files at 100 MB and warns above 50 MB, so we keep the
# folder OUT of git and deploy photos separately (rsync / CDN / photo
# host). The `.gitkeep` files preserve the folder structure so a fresh
# clone still boots without errors — the filesystem gallery loader
# treats empty folders as "coming soon" categories.
public/assets/**/*
!public/assets/
!public/assets/*/
!public/assets/**/.gitkeep
